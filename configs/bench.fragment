# Benchmark kernel: virtme-ng minimal config (vng --kconfig) + this fragment.
# Only what bench.sh needs; no debug, sanitizers or instrumentation.
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_XDP_SOCKETS=y
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_NET_PKTGEN=y
CONFIG_PAGE_POOL=y
CONFIG_PAGE_POOL_STATS=y
CONFIG_INET=y
CONFIG_IPV6=y
